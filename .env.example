# Server-only V1 provider selection. Sunburst is retained for explicit development testing.
# Use SMILE_PROVIDER (the existing equivalent of IMAGE_PROVIDER).
SMILE_PROVIDER=gemini
# Cloudflare: add this as an encrypted Worker secret, never a public variable.
# Netlify: use this dedicated server key (Builds and Functions scopes).
SMILE_GEMINI_API_KEY=
# Local development / Sites compatibility:
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Ordinary Gemini generation sends source + canonical prompt, without mask guidance.
SMILE_MASK_GUIDANCE=off

# Google data terms that govern patient photos — an OWNER CONFIRMATION, set only
# after verifying the configuration (docs/SUBPROCESSORS.md). Live generation is
# refused until set: "paid" (Gemini Developer API with Cloud Billing, AI Studio
# logging off, Google Cloud DPA accepted) or "vertex" (Vertex AI). Never unpaid tier.
SMILE_GEMINI_DATA_TERMS=

# Vertex AI instead of the Developer API: SMILE_PROVIDER=vertex. Server-only.
VERTEX_PROJECT_ID=
# e.g. europe-west2 (London) if the image model is offered there, or global.
VERTEX_LOCATION=
# Service account JSON (least privilege: Vertex AI User). Worker secret only.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional development-only Sunburst: explicitly select SMILE_PROVIDER=openai,
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst. No automatic provider fallback.
# Blocked unless SMILE_OPENAI_DATA_TERMS=api after DPA/DPIA/privacy updates.
SMILE_OPENAI_DATA_TERMS=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=high

# Optional custom HTTPS backend (NOT a V1 processor): set SMILE_PROVIDER to http instead.
# Blocked unless SMILE_PROVIDER_DATA_TERMS=confirmed.
SMILE_PROVIDER_DATA_TERMS=
SMILE_PROVIDER_URL=
SMILE_PROVIDER_API_KEY=

# Development only: SMILE_PROVIDER=mock returns the original image unchanged.
# The in-app test mode uses bundled sample images and needs no API key.
# Never prefix any secret variable with NEXT_PUBLIC_.

# --- Accounts and subscriptions (see PAYMENTS_AUTH_SETUP.md) ---
# Public, client-side (inlined into the web and iOS bundles; safe by design):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public Apple SDK key (appl_...). Never a test_ key in release builds.
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=
# Optional: API origin for the iOS app (defaults to the Cloudflare deployment).
NEXT_PUBLIC_SMILE_API_ORIGIN=

# --- Legal identity (OWNER DECISIONS; public; used by /privacy.html and /terms.html) ---
# Leave blank until confirmed: the pages show marked placeholders and
# `npm run ios:release` refuses to build. See docs/PROFESSIONAL_REVIEW_REQUIRED.md.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_LEGAL_COMPANY_NUMBER=
NEXT_PUBLIC_ICO_REGISTRATION_NUMBER=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
# Support (public). Report a Problem / Contact Support use this mailbox (falls back
# to the privacy contact). Optional help centre URL; otherwise built-in help is shown.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_HELP_URL=

# Server-only secrets (Cloudflare: `npx wrangler secret put NAME`; never NEXT_PUBLIC_):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REVENUECAT_SECRET_API_KEY=
# Exact Authorization header value configured on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=
# "true" (default) accepts App Store sandbox purchases (TestFlight and App Review use sandbox).
REVENUECAT_ALLOW_SANDBOX=
# Sign in with Apple token revocation on account deletion:
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=

# Case Library: how many of the clinician's matching finished cases are sent
# as style references with a generation (1–5; default 3).
STYLE_REFERENCE_LIMIT=3

# Patient-case sync reuses the account configuration above; no additional secret.
# Apply supabase/migrations/20261002093305_patient_case_sync.sql to STAGING first.
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are server-only. Client public URL/anon
# key must point to that same project. The dedicated patient-cases bucket is private.
