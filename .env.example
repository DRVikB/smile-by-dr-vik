# Required for the current Gemini image-generation backend. Server-only.
# Set SMILE_PROVIDER to gemini and GEMINI_IMAGE_MODEL to gemini-3.1-flash-image.
SMILE_PROVIDER=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# Optional alternative: set SMILE_PROVIDER to openai instead.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Optional custom HTTPS backend: set SMILE_PROVIDER to http instead.
SMILE_PROVIDER_URL=
SMILE_PROVIDER_API_KEY=

# Development only: SMILE_PROVIDER=mock returns the original image unchanged.
# The in-app test mode uses bundled sample images and needs no API key.
# Never prefix any secret variable with NEXT_PUBLIC_.
