# ---- Google Gemini "Nano Banana" (recommended for smile editing) ----
# Best at keeping the patient's real face and changing only the teeth.
# Get a key at https://aistudio.google.com/apikey (use a paid/billed project;
# do NOT rely on the free tier for patient photos — Google may train on it).
SMILE_PROVIDER=gemini
GEMINI_API_KEY=
# Model options (cost per image, Sept 2026):
#   gemini-3.1-flash-image   default, ~$0.067   (current workhorse)
#   gemini-2.5-flash-image   cheapest, ~$0.039
#   gemini-3-pro-image       premium, ~$0.134   (hero results)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ---- OpenAI image editing (alternative) ----
# A key here (without SMILE_PROVIDER) selects OpenAI automatically.
# SMILE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2      # or gpt-image-1-mini for the cheapest option

# ---- Offline demo mode (returns the original photo unchanged) ----
# SMILE_PROVIDER=mock

# ---- Optional generic HTTP provider ----
# SMILE_PROVIDER=http
# SMILE_PROVIDER_URL=https://your-provider.example/api/edit
# SMILE_PROVIDER_API_KEY=
