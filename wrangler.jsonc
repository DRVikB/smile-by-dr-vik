{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smile-by-dr-vik",
  "account_id": "cd90a72db6c2e3b483a517f99d3ec552",
  "main": "dist/cloudflare/index.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/sw.js"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "SMILE_PROVIDER": "gemini",
    "GEMINI_IMAGE_MODEL": "gemini-3.1-flash-image"
  },
  "durable_objects": {
    "bindings": [{ "name": "REQUEST_GUARD", "class_name": "SmileRequestGuard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SmileRequestGuard"] }],
  // Worker logs stay off: request bodies can contain patient photographs.
  "observability": { "enabled": false },
  "env": {
    // Staging: synthetic/demo data only. Use a separate Supabase project and
    // separate secrets (`npx wrangler secret put NAME --env staging`).
    // Deploy with `npx wrangler deploy --env staging`.
    "staging": {
      "name": "smile-by-dr-vik-staging",
      "vars": { "SMILE_PROVIDER": "gemini", "GEMINI_IMAGE_MODEL": "gemini-3.1-flash-image" },
      "durable_objects": {
        "bindings": [{ "name": "REQUEST_GUARD", "class_name": "SmileRequestGuard" }]
      },
      "observability": { "enabled": false }
    }
  }
}
