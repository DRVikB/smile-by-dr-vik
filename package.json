{
  "name": "smile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3006",
    "build": "next build && node scripts/build-worker.mjs",
    "start": "next start --hostname 0.0.0.0 --port 3006",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:next": "next build",
    "lint": "eslint src tests scripts --max-warnings=0",
    "check:production": "npm run lint && npm test && npm run build && node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@netlify/blobs": "^11.1.0",
    "heic-to": "^1.5.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
