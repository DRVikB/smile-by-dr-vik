{
  "name": "smile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:cloudflare": "npm run build && node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev --var SMILE_PROVIDER:mock",
    "test:cloudflare": "tsx scripts/verify-cloudflare.ts",
    "dev": "next dev --hostname 0.0.0.0 --port 3006",
    "build": "npm run legal && node scripts/copy-ort.mjs && next build && node scripts/build-worker.mjs",
    "start": "next start --hostname 0.0.0.0 --port 3006",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:next": "npm run legal && node scripts/copy-ort.mjs && next build",
    "build:native": "npm run build && node scripts/build-native.mjs",
    "ios:sync": "npm run build:native && cap sync ios && node scripts/verify-ios-bundle.mjs",
    "ios:release": "SMILE_RELEASE_BUILD=1 npm run ios:sync",
    "ios:testflight-internal": "SMILE_TESTFLIGHT_INTERNAL=1 NEXT_PUBLIC_DISTRIBUTION=internal-testflight npm run ios:sync",
    "ios:bump-build": "node scripts/bump-ios-build.mjs",
    "ios:open": "cap open ios",
    "check:app-store": "npm run legal && node scripts/check-app-store.mjs",
    "lint": "eslint src tests scripts --max-warnings=0",
    "check:production": "npm run lint && npm test && npm run build && node scripts/verify-production.mjs",
    "legal": "node --import tsx scripts/build-legal.ts",
    "predev": "npm run legal && node scripts/copy-ort.mjs",
    "qa:ios-simulator": "node scripts/qa-ios-simulator.mjs",
    "qa:ios-live-generation": "node scripts/run-ios-live-qa.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@mediapipe/tasks-vision": "1.0.1",
    "@netlify/blobs": "^11.1.0",
    "@revenuecat/purchases-capacitor": "^13.6.1",
    "@supabase/supabase-js": "^2.117.2",
    "heic-to": "^1.5.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.8",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@cloudflare/workers-types": "^5.20260925.2",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "onnxruntime-node": "^1.30.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
